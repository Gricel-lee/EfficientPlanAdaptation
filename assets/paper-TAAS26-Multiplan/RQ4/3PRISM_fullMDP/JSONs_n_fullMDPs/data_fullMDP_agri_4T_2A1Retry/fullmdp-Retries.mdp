mdp
// Labels & formulae 
label "success" = t1l4=1 & t2l8a=1 & t3l4=1 & t3l7=1;
label "done" = !(t1l4=0) & !(t2l8a=0) & !(t3l4=0) & !(t3l7=0);
formula success = t1l4=1 & t2l8a=1 & t3l4=1 & t3l7=1;
// Retries
const int worker1_maxRetry_t1l4_SET = 1;
const int worker1_maxRetry_t3l4_SET = 1;
const int worker1_maxRetry_t3l7_SET = 1;
const int r3_maxRetry_t2l8a_SET = 1;
const int r3_maxRetry_t3l4_SET = 1;
const int r3_maxRetry_t3l7_SET = 1;
// Cost
const int worker1_cost_t1l4 = 3;
const int worker1_cost_t3l4 = 5;
const int worker1_cost_t3l7 = 5;
const int r3_cost_t2l8a = 1;
const int r3_cost_t3l4 = 1;
const int r3_cost_t3l7 = 1;
// Turn and retry selection
module selectRetries
  turn : [0..8] init 1; // turn =0 to 8: retry selection, turn=8: planning
  worker1_maxRetry_t1l4 : [0..worker1_maxRetry_t1l4_SET] init 0;
  worker1_maxRetry_t3l4 : [0..worker1_maxRetry_t3l4_SET] init 0;
  worker1_maxRetry_t3l7 : [0..worker1_maxRetry_t3l7_SET] init 0;
  r3_maxRetry_t2l8a : [0..r3_maxRetry_t2l8a_SET] init 0;
  r3_maxRetry_t3l4 : [0..r3_maxRetry_t3l4_SET] init 0;
  r3_maxRetry_t3l7 : [0..r3_maxRetry_t3l7_SET] init 0;
  worker1Alloct1l4:bool init false;
  worker1Alloct3l4:bool init false;
  worker1Alloct3l7:bool init false;
  r3Alloct2l8a:bool init false;
  r3Alloct3l4:bool init false;
  r3Alloct3l7:bool init false;
  [selectRetriesworker1t1l4_1] turn=0 -> 1:(worker1_maxRetry_t1l4'= 1) & (worker1Alloct1l4'=true) & (turn'=turn+1);
  [selectRetriesworker1t3l4_1] turn=1 -> 1:(worker1_maxRetry_t3l4'= 1) & (worker1Alloct3l4'=true) & (turn'=turn+1);
  [selectRetriesworker1t3l7_1] turn=2 -> 1:(worker1_maxRetry_t3l7'= 1) & (worker1Alloct3l7'=true) & (turn'=turn+1);
  [selectRetriesr3t2l8a_1] turn=3 -> 1:(r3_maxRetry_t2l8a'= 1) & (r3Alloct2l8a'=true) & (turn'=turn+1);
  [selectRetriesr3t3l4_1] turn=4 -> 1:(r3_maxRetry_t3l4'= 1) & (r3Alloct3l4'=true) & (turn'=turn+1);
  [selectRetriesr3t3l7_1] turn=5 -> 1:(r3_maxRetry_t3l7'= 1) & (r3Alloct3l7'=true) & (turn'=turn+1);

endmodule


module agents
  //  worker1 state vars
  worker1Loc : [0..9] init 1; //location
  worker1retry_t1l4 : [0..1000] init 0; //retry
  worker1retry_t3l4 : [0..1000] init 0; //retry
  worker1retry_t3l7 : [0..1000] init 0; //retry
  //  r3 state vars
  r3Loc : [0..9] init 1; //location
  r3retry_t2l8a : [0..1000] init 0; //retry
  r3retry_t3l4 : [0..1000] init 0; //retry
  r3retry_t3l7 : [0..1000] init 0; //retry
  // empty locations
  emptyl1 : bool init false;
  emptyl2 : bool init true;
  emptyl3 : bool init true;
  emptyl4 : bool init true;
  emptyl5 : bool init true;
  emptyl6 : bool init true;
  emptyl7 : bool init true;
  emptyl8 : bool init true;
  emptyl9 : bool init true;
  // tasks
  t1l4 : [0..2] init 0; //1: success, 2: failure
  t2l8a : [0..2] init 0; //1: success, 2: failure
  t3l4 : [0..2] init 0; //1: success, 2: failure
  t3l7 : [0..2] init 0; //1: success, 2: failure


  // Transitions move
  // worker1
  [worker1movel1_l2] worker1Loc=1 & emptyl2 & turn=6 & !success-> 1.0 : (emptyl1'=true) & (emptyl2'=false) & (worker1Loc'=2);
  [worker1movel2_l1] worker1Loc=2 & emptyl1 & turn=6 & !success -> 1.0 : (emptyl2'=true) & (emptyl1'=false) & (worker1Loc'=1);
  [worker1movel1_l4] worker1Loc=1 & emptyl4 & turn=6 & !success-> 1.0 : (emptyl1'=true) & (emptyl4'=false) & (worker1Loc'=4);
  [worker1movel4_l1] worker1Loc=4 & emptyl1 & turn=6 & !success -> 1.0 : (emptyl4'=true) & (emptyl1'=false) & (worker1Loc'=1);
  [worker1movel2_l3] worker1Loc=2 & emptyl3 & turn=6 & !success-> 1.0 : (emptyl2'=true) & (emptyl3'=false) & (worker1Loc'=3);
  [worker1movel3_l2] worker1Loc=3 & emptyl2 & turn=6 & !success -> 1.0 : (emptyl3'=true) & (emptyl2'=false) & (worker1Loc'=2);
  [worker1movel2_l5] worker1Loc=2 & emptyl5 & turn=6 & !success-> 1.0 : (emptyl2'=true) & (emptyl5'=false) & (worker1Loc'=5);
  [worker1movel5_l2] worker1Loc=5 & emptyl2 & turn=6 & !success -> 1.0 : (emptyl5'=true) & (emptyl2'=false) & (worker1Loc'=2);
  [worker1movel3_l6] worker1Loc=3 & emptyl6 & turn=6 & !success-> 1.0 : (emptyl3'=true) & (emptyl6'=false) & (worker1Loc'=6);
  [worker1movel6_l3] worker1Loc=6 & emptyl3 & turn=6 & !success -> 1.0 : (emptyl6'=true) & (emptyl3'=false) & (worker1Loc'=3);
  [worker1movel4_l5] worker1Loc=4 & emptyl5 & turn=6 & !success-> 1.0 : (emptyl4'=true) & (emptyl5'=false) & (worker1Loc'=5);
  [worker1movel5_l4] worker1Loc=5 & emptyl4 & turn=6 & !success -> 1.0 : (emptyl5'=true) & (emptyl4'=false) & (worker1Loc'=4);
  [worker1movel4_l7] worker1Loc=4 & emptyl7 & turn=6 & !success-> 1.0 : (emptyl4'=true) & (emptyl7'=false) & (worker1Loc'=7);
  [worker1movel7_l4] worker1Loc=7 & emptyl4 & turn=6 & !success -> 1.0 : (emptyl7'=true) & (emptyl4'=false) & (worker1Loc'=4);
  [worker1movel5_l6] worker1Loc=5 & emptyl6 & turn=6 & !success-> 1.0 : (emptyl5'=true) & (emptyl6'=false) & (worker1Loc'=6);
  [worker1movel6_l5] worker1Loc=6 & emptyl5 & turn=6 & !success -> 1.0 : (emptyl6'=true) & (emptyl5'=false) & (worker1Loc'=5);
  [worker1movel5_l8] worker1Loc=5 & emptyl8 & turn=6 & !success-> 1.0 : (emptyl5'=true) & (emptyl8'=false) & (worker1Loc'=8);
  [worker1movel8_l5] worker1Loc=8 & emptyl5 & turn=6 & !success -> 1.0 : (emptyl8'=true) & (emptyl5'=false) & (worker1Loc'=5);
  [worker1movel6_l9] worker1Loc=6 & emptyl9 & turn=6 & !success-> 1.0 : (emptyl6'=true) & (emptyl9'=false) & (worker1Loc'=9);
  [worker1movel9_l6] worker1Loc=9 & emptyl6 & turn=6 & !success -> 1.0 : (emptyl9'=true) & (emptyl6'=false) & (worker1Loc'=6);
  [worker1movel7_l8] worker1Loc=7 & emptyl8 & turn=6 & !success-> 1.0 : (emptyl7'=true) & (emptyl8'=false) & (worker1Loc'=8);
  [worker1movel8_l7] worker1Loc=8 & emptyl7 & turn=6 & !success -> 1.0 : (emptyl8'=true) & (emptyl7'=false) & (worker1Loc'=7);
  [worker1movel8_l9] worker1Loc=8 & emptyl9 & turn=6 & !success-> 1.0 : (emptyl8'=true) & (emptyl9'=false) & (worker1Loc'=9);
  [worker1movel9_l8] worker1Loc=9 & emptyl8 & turn=6 & !success -> 1.0 : (emptyl9'=true) & (emptyl8'=false) & (worker1Loc'=8);
  // r3
  [r3movel1_l2] r3Loc=1 & emptyl2 & turn=6 & !success-> 1.0 : (emptyl1'=true) & (emptyl2'=false) & (r3Loc'=2);
  [r3movel2_l1] r3Loc=2 & emptyl1 & turn=6 & !success -> 1.0 : (emptyl2'=true) & (emptyl1'=false) & (r3Loc'=1);
  [r3movel1_l4] r3Loc=1 & emptyl4 & turn=6 & !success-> 1.0 : (emptyl1'=true) & (emptyl4'=false) & (r3Loc'=4);
  [r3movel4_l1] r3Loc=4 & emptyl1 & turn=6 & !success -> 1.0 : (emptyl4'=true) & (emptyl1'=false) & (r3Loc'=1);
  [r3movel2_l3] r3Loc=2 & emptyl3 & turn=6 & !success-> 1.0 : (emptyl2'=true) & (emptyl3'=false) & (r3Loc'=3);
  [r3movel3_l2] r3Loc=3 & emptyl2 & turn=6 & !success -> 1.0 : (emptyl3'=true) & (emptyl2'=false) & (r3Loc'=2);
  [r3movel2_l5] r3Loc=2 & emptyl5 & turn=6 & !success-> 1.0 : (emptyl2'=true) & (emptyl5'=false) & (r3Loc'=5);
  [r3movel5_l2] r3Loc=5 & emptyl2 & turn=6 & !success -> 1.0 : (emptyl5'=true) & (emptyl2'=false) & (r3Loc'=2);
  [r3movel3_l6] r3Loc=3 & emptyl6 & turn=6 & !success-> 1.0 : (emptyl3'=true) & (emptyl6'=false) & (r3Loc'=6);
  [r3movel6_l3] r3Loc=6 & emptyl3 & turn=6 & !success -> 1.0 : (emptyl6'=true) & (emptyl3'=false) & (r3Loc'=3);
  [r3movel4_l5] r3Loc=4 & emptyl5 & turn=6 & !success-> 1.0 : (emptyl4'=true) & (emptyl5'=false) & (r3Loc'=5);
  [r3movel5_l4] r3Loc=5 & emptyl4 & turn=6 & !success -> 1.0 : (emptyl5'=true) & (emptyl4'=false) & (r3Loc'=4);
  [r3movel4_l7] r3Loc=4 & emptyl7 & turn=6 & !success-> 1.0 : (emptyl4'=true) & (emptyl7'=false) & (r3Loc'=7);
  [r3movel7_l4] r3Loc=7 & emptyl4 & turn=6 & !success -> 1.0 : (emptyl7'=true) & (emptyl4'=false) & (r3Loc'=4);
  [r3movel5_l6] r3Loc=5 & emptyl6 & turn=6 & !success-> 1.0 : (emptyl5'=true) & (emptyl6'=false) & (r3Loc'=6);
  [r3movel6_l5] r3Loc=6 & emptyl5 & turn=6 & !success -> 1.0 : (emptyl6'=true) & (emptyl5'=false) & (r3Loc'=5);
  [r3movel5_l8] r3Loc=5 & emptyl8 & turn=6 & !success-> 1.0 : (emptyl5'=true) & (emptyl8'=false) & (r3Loc'=8);
  [r3movel8_l5] r3Loc=8 & emptyl5 & turn=6 & !success -> 1.0 : (emptyl8'=true) & (emptyl5'=false) & (r3Loc'=5);
  [r3movel6_l9] r3Loc=6 & emptyl9 & turn=6 & !success-> 1.0 : (emptyl6'=true) & (emptyl9'=false) & (r3Loc'=9);
  [r3movel9_l6] r3Loc=9 & emptyl6 & turn=6 & !success -> 1.0 : (emptyl9'=true) & (emptyl6'=false) & (r3Loc'=6);
  [r3movel7_l8] r3Loc=7 & emptyl8 & turn=6 & !success-> 1.0 : (emptyl7'=true) & (emptyl8'=false) & (r3Loc'=8);
  [r3movel8_l7] r3Loc=8 & emptyl7 & turn=6 & !success -> 1.0 : (emptyl8'=true) & (emptyl7'=false) & (r3Loc'=7);
  [r3movel8_l9] r3Loc=8 & emptyl9 & turn=6 & !success-> 1.0 : (emptyl8'=true) & (emptyl9'=false) & (r3Loc'=9);
  [r3movel9_l8] r3Loc=9 & emptyl8 & turn=6 & !success -> 1.0 : (emptyl9'=true) & (emptyl8'=false) & (r3Loc'=8);


  // Transitions dotask
  // worker1
  [worker1dotask_t1l4] t1l4=0 & worker1Alloct1l4 & worker1Loc=4 & worker1retry_t1l4<worker1_maxRetry_t1l4  & turn=6 -> 1.0 : (t1l4'=1) + 0.0 : (worker1retry_t1l4'=worker1retry_t1l4+1);
  [worker1dotask_t1l4] t1l4=0 & worker1Alloct1l4 & worker1Loc=4 & worker1retry_t1l4>=worker1_maxRetry_t1l4  & turn=6 -> 1 : (t1l4'=2);
  [worker1dotask_t3l4] t3l4=0 & worker1Alloct3l4 & worker1Loc=4 & worker1retry_t3l4<worker1_maxRetry_t3l4  & turn=6 -> 0.99 : (t3l4'=1) + 0.01 : (worker1retry_t3l4'=worker1retry_t3l4+1);
  [worker1dotask_t3l4] t3l4=0 & worker1Alloct3l4 & worker1Loc=4 & worker1retry_t3l4>=worker1_maxRetry_t3l4  & turn=6 -> 1 : (t3l4'=2);
  [worker1dotask_t3l7] t3l7=0 & worker1Alloct3l7 & worker1Loc=7 & worker1retry_t3l7<worker1_maxRetry_t3l7  & turn=6 -> 0.99 : (t3l7'=1) + 0.01 : (worker1retry_t3l7'=worker1retry_t3l7+1);
  [worker1dotask_t3l7] t3l7=0 & worker1Alloct3l7 & worker1Loc=7 & worker1retry_t3l7>=worker1_maxRetry_t3l7  & turn=6 -> 1 : (t3l7'=2);
  // r3
  [r3dotask_t2l8a] t2l8a=0 & r3Alloct2l8a & r3Loc=8 & r3retry_t2l8a<r3_maxRetry_t2l8a  & turn=6 -> 0.99 : (t2l8a'=1) + 0.01 : (r3retry_t2l8a'=r3retry_t2l8a+1);
  [r3dotask_t2l8a] t2l8a=0 & r3Alloct2l8a & r3Loc=8 & r3retry_t2l8a>=r3_maxRetry_t2l8a  & turn=6 -> 1 : (t2l8a'=2);
  [r3dotask_t3l4] t3l4=0 & r3Alloct3l4 & r3Loc=4 & r3retry_t3l4<r3_maxRetry_t3l4  & turn=6 -> 1 : (t3l4'=1) + 0 : (r3retry_t3l4'=r3retry_t3l4+1);
  [r3dotask_t3l4] t3l4=0 & r3Alloct3l4 & r3Loc=4 & r3retry_t3l4>=r3_maxRetry_t3l4  & turn=6 -> 1 : (t3l4'=2);
  [r3dotask_t3l7] t3l7=0 & r3Alloct3l7 & r3Loc=7 & r3retry_t3l7<r3_maxRetry_t3l7  & turn=6 -> 1 : (t3l7'=1) + 0 : (r3retry_t3l7'=r3retry_t3l7+1);
  [r3dotask_t3l7] t3l7=0 & r3Alloct3l7 & r3Loc=7 & r3retry_t3l7>=r3_maxRetry_t3l7  & turn=6 -> 1 : (t3l7'=2);
endmodule


// Reward: cost
rewards
  // worker1 move
  [worker1movel1_l2] true : 1;
  [worker1movel2_l1] true : 1;
  [worker1movel1_l4] true : 1;
  [worker1movel4_l1] true : 1;
  [worker1movel2_l3] true : 1;
  [worker1movel3_l2] true : 1;
  [worker1movel2_l5] true : 1;
  [worker1movel5_l2] true : 1;
  [worker1movel3_l6] true : 1;
  [worker1movel6_l3] true : 1;
  [worker1movel4_l5] true : 1;
  [worker1movel5_l4] true : 1;
  [worker1movel4_l7] true : 1;
  [worker1movel7_l4] true : 1;
  [worker1movel5_l6] true : 1;
  [worker1movel6_l5] true : 1;
  [worker1movel5_l8] true : 1;
  [worker1movel8_l5] true : 1;
  [worker1movel6_l9] true : 1;
  [worker1movel9_l6] true : 1;
  [worker1movel7_l8] true : 1;
  [worker1movel8_l7] true : 1;
  [worker1movel8_l9] true : 1;
  [worker1movel9_l8] true : 1;
  // worker1 dotask
  [worker1dotask_t1l4] true : worker1_cost_t1l4;
  [worker1dotask_t3l4] true : worker1_cost_t3l4;
  [worker1dotask_t3l7] true : worker1_cost_t3l7;
  // r3 move
  [r3movel1_l2] true : 1;
  [r3movel2_l1] true : 1;
  [r3movel1_l4] true : 1;
  [r3movel4_l1] true : 1;
  [r3movel2_l3] true : 1;
  [r3movel3_l2] true : 1;
  [r3movel2_l5] true : 1;
  [r3movel5_l2] true : 1;
  [r3movel3_l6] true : 1;
  [r3movel6_l3] true : 1;
  [r3movel4_l5] true : 1;
  [r3movel5_l4] true : 1;
  [r3movel4_l7] true : 1;
  [r3movel7_l4] true : 1;
  [r3movel5_l6] true : 1;
  [r3movel6_l5] true : 1;
  [r3movel5_l8] true : 1;
  [r3movel8_l5] true : 1;
  [r3movel6_l9] true : 1;
  [r3movel9_l6] true : 1;
  [r3movel7_l8] true : 1;
  [r3movel8_l7] true : 1;
  [r3movel8_l9] true : 1;
  [r3movel9_l8] true : 1;
  // r3 dotask
  [r3dotask_t2l8a] true : r3_cost_t2l8a;
  [r3dotask_t3l4] true : r3_cost_t3l4;
  [r3dotask_t3l7] true : r3_cost_t3l7;
endrewards