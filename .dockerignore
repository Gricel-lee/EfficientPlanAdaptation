.vscode
.gitignore
*.swp
.DS_Store

# Python cache
**/__pycache__/
*.pyc
*.pyo
*.pyd

# EvoChecker is git-cloned during build; exclude local copy to avoid conflict
src/arch/apps/EvoChecker/

# Local virtual environment (not needed in Docker)
src/arch/prj-venv/

# src/libs is generated by run.sh; recreated in Dockerfile from EvoChecker clone
src/libs/
libs/

# Generated output (not source)
src/output/
assets/planningProblem/Test-examples/output_example_*/

# Log files
src/out8888.txt
src/ServerError8888.txt
src/ServerOutput8888.txt

# Assets are bind-mounted at runtime
assets/